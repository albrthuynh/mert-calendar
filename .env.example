DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
AUTH_SECRET="generate_with_npx_auth_secret"
AUTH_GOOGLE_ID="your_google_oauth_client_id"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

# Keep this independent from AUTH_SECRET. Generate once with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="32_random_bytes_as_64_hex_characters"
# Optional comma-separated old keys retained while rotating credentials.
TOKEN_ENCRYPTION_PREVIOUS_KEYS=""
# Use staged only during the coordinated rollout; enabled encrypts every new token.
TOKEN_ENCRYPTION_MODE="enabled"
# Turn on only after every active runtime encrypts writes and the backfill reports zero plaintext.
TOKEN_ENCRYPTION_REQUIRE_ENCRYPTED="false"
# Protects scheduled watch renewal and expired security-record cleanup.
CRON_SECRET="a_separate_random_secret"

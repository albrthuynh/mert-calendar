generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  calendarBackgroundUrl    String?
  calendarTopLeftUrl       String?
  notificationsEnabled     Boolean   @default(false)
  defaultReminderMinutes   Int       @default(10)
  notificationSoundEnabled Boolean   @default(true)
  notificationSound        String?
  notificationVolume       Int       @default(80)
  calendarSubscriptionToken String?  @unique @default(cuid())
  googleCalendarSyncEnabled Boolean   @default(false)
  googleCalendarSyncToken    String?
  googleCalendarLastSyncedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  googleCalendarChannels   GoogleCalendarChannel[]
  googleCalendarSources    GoogleCalendarSource[]
  events                   Event[]
  sessions                 Session[]
  todos                    Todo[]
  importantDays            ImportantDay[]
  jobApplications          JobApplication[]
}

enum JobApplicationStatus {
  APPLIED
  OA
  INTERVIEWING
  ACCEPTED
  REJECTED
}

model JobApplication {
  id             String               @id @default(cuid())
  title          String
  company        String
  dateApplied    String
  status         JobApplicationStatus @default(APPLIED)
  applicationUrl String?
  location       String?
  salary         String?
  notes          String?
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, dateApplied])
}

model ImportantDay {
  id        String   @id @default(cuid())
  /// Calendar day in the user's local sense, stored as YYYY-MM-DD for stable queries
  date      String
  label     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GoogleCalendarChannel {
  id         String    @id @default(cuid())
  userId     String
  calendarId String
  channelId  String    @unique
  resourceId String?
  token      String
  expiration DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calendarId, active])
}

/// Extra Google calendars the user imports events from (read-only).
/// The primary calendar is not stored here; it always syncs read/write.
model GoogleCalendarSource {
  id           String    @id @default(cuid())
  userId       String
  calendarId   String
  summary      String
  color        String?
  syncToken    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId])
}

model Event {
  id                String    @id @default(cuid())
  instanceId        String?   @unique
  title             String
  description       String?
  link              String?
  startTime         DateTime
  endTime           DateTime
  color             String    @default("#4285F4")
  allDay            Boolean   @default(false)
  recurrenceRule    String?
  recurrenceEndDate DateTime?
  reminderMinutes   Int?
  reminderDisabled  Boolean   @default(false)
  deleted           Boolean   @default(false)
  googleCalendarId  String?
  googleEventId     String?
  googleEtag        String?
  googleUpdatedAt   DateTime?
  googleSyncedAt    DateTime?
  userId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parentEventId String?
  parentEvent   Event?  @relation("EventChildren", fields: [parentEventId], references: [id])
  childEvents   Event[] @relation("EventChildren")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleCalendarId, googleEventId])
  @@index([userId, parentEventId, deleted])
  @@index([userId, startTime])
  @@index([userId, endTime])
  @@index([userId, recurrenceEndDate])
  @@index([userId, updatedAt])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  order       Int       @default(0)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  taskDate    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taskDate])
}
